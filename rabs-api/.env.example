# ============================================================================
# ABS Interiors API - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Application Environment
NODE_ENV=development
PORT=4000

# Database Configuration
DB_HOST=your_db_host
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT Configuration (Generate strong random secrets for production)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=31536000
JWT_REFRESH_TTL=31536000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/iam/auth/google/callback
# Production: https://api.rabsinteriors.app/api/iam/auth/google/callback

# Public origin of this API (used in /api root response)
PUBLIC_API_URL=http://localhost:4000

# Frontend URL
FRONTEND_URL=http://localhost:3000
B2B_WEBSITE_URL=http://localhost:3001
# Production: FRONTEND_URL=https://rabsinteriors.app
# Production: B2B_WEBSITE_URL=https://b2b.rabsinteriors.app

# Worldpay Access (optional bootstrap; prefer Finance → Payment Dashboard / PaymentGateway row)
# Never commit real secrets. Seed with: npx tsx src/scripts/seedWorldpayGateway.ts
WORLDPAY_USERNAME=
WORLDPAY_API_PASSWORD=
WORLDPAY_MERCHANT_ENTITY=default
WORLDPAY_MODE=test

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_S3_BUCKET_URL=https://your_bucket_name.s3.ap-south-1.amazonaws.com

# Encrypts saved channel/gateway credentials (falls back to JWT_ACCESS_SECRET)
CHANNEL_CREDENTIALS_SECRET=

# Bootstrap Token (for development seeding - optional)
# BOOTSTRAP_TOKEN=your_bootstrap_token_here

# Meta / Facebook / Instagram (see docs/META_SOCIAL_SETUP.md)
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
# Unused by the OAuth dialog. Login Config IDs often inject invalid Graph scopes
# (pages_manage_posts, instagram_content_publish, read_insights, …). Connect uses
# META_OAUTH_SCOPES / the ERP default instead. Leave blank unless you create a
# config that lists only those valid names.
META_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# Optional comma-separated Facebook Login scopes for default Connect. Leave empty for:
# business_management,pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,instagram_basic
# Publish (pages_manage_posts, instagram_content_publish, …) is requested only via
# GET /api/social/meta/connect?intent=publish (classic /dialog/oauth, no config_id).
# Ads via intent=ads. Do not put publish names into a Login for Business configuration.
META_OAUTH_SCOPES=
META_REDIRECT_URI=http://localhost:4000/api/social/meta/callback
# Production: https://api.rabsinteriors.app/api/social/meta/callback
META_API_PUBLIC_URL=http://localhost:4000
# Production: https://api.rabsinteriors.app

# --- CRM external lead ingest (optional MVP fallback; prefer DB crm_integration_keys) ---
# CRM_LEAD_INGEST_API_KEY=
# CRM_LEAD_INGEST_ORG_ID=1

# --- Gmail SMTP (Marketing cold email campaigns) ---
# Create a Google App Password for the sending account (2FA required).
# Never commit real passwords. Never log SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SendGrid (optional global fallback; prefer per-org email connectors) ---
# Never commit real keys. Never log SENDGRID_API_KEY.
# Panels: Marketing → Email connectors → provider=sendgrid + apiKey in credentials.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_WEBHOOK_SECRET=
# Optional Signed Event Webhook public key (PEM)
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# --- DHL Express MyDHL API ---
# Auth is Basic(API Key : API Secret) — NOT the developer portal login.
# Portal: https://developer.dhl.com → Apps → rabs_erp → Show Key / API Secret
# Sandbox: https://express.api.dhl.com/mydhlapi/test
# Live:    https://express.api.dhl.com/mydhlapi  (keys may take ~24h after approval)
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_MODE=test
DHL_DEFAULT_PRODUCT_CODE=N
DHL_SHIPPER_NAME=
DHL_SHIPPER_COMPANY=
DHL_SHIPPER_PHONE=
DHL_SHIPPER_EMAIL=
DHL_SHIPPER_ADDRESS1=
DHL_SHIPPER_ADDRESS2=
DHL_SHIPPER_CITY=
DHL_SHIPPER_POSTAL=
DHL_SHIPPER_COUNTRY=GB
DHL_SHIPPER_STATE=

# --- Database: environments ---
# PRODUCTION (VPS only — /var/www/rabs-api/.env on <VPS_HOST>):
#   Must use the VPS Docker MySQL. Do NOT point production at Hostinger shared MySQL.
#   DB_HOST=127.0.0.1
#   DB_PORT=32768
#   DB_USERNAME=<db_user>
#   DB_NAME=rabs_interiors
#   DB_PASSWORD=...  (from /docker/mysql-6ep8/.env MYSQL_PASSWORD; quote if it contains #)
#   Never publish MySQL :32768 to the public internet — keep bind/firewall localhost-only.
#
# LOCAL / DEV (prefer SSH tunnel to VPS MySQL for production-parity):
#   ssh -i ~/.ssh/id_ed25519_hostinger -o IdentitiesOnly=yes -N \
#       -L 32768:127.0.0.1:32768 root@<VPS_HOST>
#   Then: DB_HOST=127.0.0.1 DB_PORT=32768 DB_USERNAME=<db_user> DB_NAME=rabs_interiors
#   Or use a local MySQL / other shared DB for day-to-day work.
#   Do not open VPS MySQL 32768 on 0.0.0.0 for local convenience.
#
# --- Hostinger VPS production app settings (server /var/www/rabs-api/.env) ---
# PORT=4015
# FRONTEND_URL=https://rabsinteriors.app
# B2B_WEBSITE_URL=https://b2b.rabsinteriors.app
# GOOGLE_REDIRECT_URI=https://api.rabsinteriors.app/api/iam/auth/google/callback
# META_REDIRECT_URI=https://api.rabsinteriors.app/api/social/meta/callback
# META_API_PUBLIC_URL=https://api.rabsinteriors.app
# PUBLIC_API_URL=https://api.rabsinteriors.app

# --- UK Accounting / HMRC MTD (optional; prefer DB acc_org_settings) ---
# Structured VAT box export works without these. Live MTD submit is placeholder until keys exist.
# Never commit real HMRC secrets.
# HMRC_MTD_CLIENT_ID=
# HMRC_MTD_CLIENT_SECRET=
# HMRC_MTD_ENABLED=false
# Public API: https://api.rabsinteriors.app
