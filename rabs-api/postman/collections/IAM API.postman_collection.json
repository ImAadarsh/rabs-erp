    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.accessToken || '');",
              "pm.collectionVariables.set('refreshToken', json.refreshToken || '');",
              "pm.collectionVariables.set('userId', (json.user && json.user.id) || pm.collectionVariables.get('userId'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@rabsinteriors.app\",\n  \"password\": \"ChangeMe!123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/iam/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "iam",
            "auth",
            "login"
          ]
        },
        "description": "Authenticate user and obtain access token."
      }
    },
