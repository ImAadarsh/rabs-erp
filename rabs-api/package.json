{
  "name": "rabs-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typeorm": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart rabs-api",
    "pm2:stop": "pm2 stop rabs-api",
    "pm2:logs": "pm2 logs rabs-api",
    "seed:reference": "tsx src/scripts/seedRabsReference.ts",
    "seed:worldpay": "tsx src/scripts/seedWorldpayGateway.ts",
    "migrate:011": "tsx src/scripts/runMigration011.ts",
    "migrate:012": "tsx src/scripts/runMigration012.ts",
    "migrate:013": "tsx src/scripts/runMigration013.ts",
    "migrate:014": "tsx src/scripts/runMigration014.ts",
    "migrate:015": "tsx src/scripts/runMigration015.ts",
    "migrate:016": "tsx src/scripts/runMigration016.ts",
    "migrate:017": "tsx src/scripts/runMigration017.ts",
    "migrate:018": "tsx src/scripts/runMigration018.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "type-fest": "^4.26.1",
    "typeorm": "^0.3.20",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
